generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            Int            @id @default(autoincrement())
  email         String         @unique
  password      String
  name          String
  role          Role
  schoolId      BigInt?
  schoolName    String?
  district      String?
  createdAt     DateTime       @default(now())
  dataUploads   DataUpload[]
  interventions Intervention[]
}

model District {
  id   Int    @id @default(autoincrement())
  name String @unique
}

model School {
  schoolId       BigInt
  academicYear   String          @default("2024-25")
  schoolName     String?
  districtName   String?
  mandalName     String?
  latitude       Float?
  longitude      Float?
  nStudents      Int
  nFlagged       Int
  avgRisk        Float
  pctCritical    Float
  rosterStudents RosterStudent[]
  students       StudentDetail[]

  @@id([schoolId, academicYear])
}

model Mandal {
  id           Int     @id @default(autoincrement())
  mandalName   String?
  districtName String?
  academicYear String  @default("2024-25")
  nStudents    Int
  nFlagged     Int
  avgRisk      Float
  latitude     Float?
  longitude    Float?

  @@unique([mandalName, districtName, academicYear])
}

model StudentDetail {
  childSno            Int
  academicYear        String         @default("2024-25")
  schoolId            BigInt
  schoolName          String?
  districtName        String?
  mandalName          String?
  gender              Int
  genderLabel         String
  casteClean          Int
  age                 Int?
  attendanceRate      Float
  maxConsecAbsence    Int
  faAvg               Float?
  saAvg               Float?
  migrationFlag       Int
  parentLiteracy      Int
  familyIncomeBracket Int
  transportAllowance  Int
  riskScore           Float
  tier                RiskTier
  drivers             Driver[]
  interventions       Intervention[]
  school              School         @relation(fields: [schoolId, academicYear], references: [schoolId, academicYear])

  @@id([childSno, academicYear])
}

model Driver {
  id           Int           @id @default(autoincrement())
  childSno     Int
  academicYear String        @default("2024-25")
  feature      String
  labelEn      String
  labelTe      String
  contrib      Float
  value        Float?
  sentenceEn   String
  sentenceTe   String
  student      StudentDetail @relation(fields: [childSno, academicYear], references: [childSno, academicYear])
}

model RosterStudent {
  id                  Int      @id @default(autoincrement())
  childSno            Int
  schoolId            BigInt
  academicYear        String   @default("2024-25")
  genderLabel         String
  attendanceRate      Float
  faAvg               Float?
  riskScore           Float
  tier                RiskTier
  grade               Int?
  migrationFlag       Int?
  casteClean          Int?
  familyIncomeBracket Int?
  school              School   @relation(fields: [schoolId, academicYear], references: [schoolId, academicYear])

  @@unique([childSno, schoolId, academicYear])
}

model Metrics {
  id                Int    @id @default(autoincrement())
  version           String @unique @default("default")
  threshold         Float
  thresholdCurrent  Float?
  trainData         Json
  testOotData       Json
  fairnessData      Json
  featureImportance Json
  prCurve           Json
  tierCounts        Json
}

model CounsellorTemplate {
  id              Int    @id @default(autoincrement())
  key             String @unique
  parentSmsEn     String
  parentSmsTe     String
  teacherScriptEn String
  teacherScriptTe String
  schemes         Json
}

model Intervention {
  id           Int           @id @default(autoincrement())
  childSno     Int
  academicYear String        @default("2024-25")
  actionType   String
  status       String        @default("pending")
  assignedTo   String
  notes        String?
  createdAt    DateTime      @default(now())
  completedAt  DateTime?
  createdBy    Int?
  student      StudentDetail @relation(fields: [childSno, academicYear], references: [childSno, academicYear])
  user         User?         @relation(fields: [createdBy], references: [id])
}

model DataUpload {
  id          Int      @id @default(autoincrement())
  slotId      String
  fileName    String
  recordCount Int
  schoolId    BigInt?
  uploadedBy  Int?
  createdAt   DateTime @default(now())
  user        User?    @relation(fields: [uploadedBy], references: [id])
}

enum RiskTier {
  Critical
  High
  Medium
  Low
}

enum Role {
  teacher
  hm
  district
  sed
}
