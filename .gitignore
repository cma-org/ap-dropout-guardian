# Python
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info
.venv/

# Large data & model artifacts (kept local only)
data/
artifacts/
models/*.pkl
models/*.joblib
models/*.json
cache/
*.parquet

# Next.js
web/.next/
web/node_modules/
web/public/data/

# Allow Next.js app route folders named "data" (source code, not data files)
!web/src/
!web/src/app/
!web/src/app/**/
!web/src/**/data/

# Misc
.DS_Store
*.log
.env
.env.local
